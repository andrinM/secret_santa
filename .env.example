# Copy to .env and fill in. Create the hash with:
#   sudo docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext 'your-family-password'
SANTA_USER=family
# Keep the single quotes: the hash contains $ signs.
SANTA_HASH='$2a$14$REPLACE_ME'
# Wishes can be edited until this day (00:00, Swiss time); from then on each Wichtel sees them.
WISH_DEADLINE=2026-12-01
